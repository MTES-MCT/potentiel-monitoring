# Route log ingestion to Vector, and all other traffic to Grafana.
<%
dns_resolver =
  ENV['NGINX_DNS_RESOLVER'] ||
  File.readlines('/etc/resolv.conf')
    .map { |line| line[/^\s*nameserver\s+([^\s#]+)/, 1] }
    .compact
    .first ||
  '127.0.0.11'
%>

# Re-resolve private-network DNS names regularly so upstream dyno IP changes
# do not require restarting nginx after a deployment.
resolver <%= dns_resolver %> valid=<%= ENV['NGINX_DNS_VALID'] || '10s' %> ipv6=off;

location /vector {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Authorization $http_authorization;
  rewrite ^/vector/?(.*)$ /$1 break;
  proxy_pass http://vector.<%= ENV['SCALINGO_APPLICATION_ID'] %>.<%= ENV['SCALINGO_PRIVATE_NETWORK_ID'] %>.private-network.internal:<%= ENV['VECTOR_PORT'] || '9001' %>;
}

location / {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass http://grafana.<%= ENV['SCALINGO_APPLICATION_ID'] %>.<%= ENV['SCALINGO_PRIVATE_NETWORK_ID'] %>.private-network.internal:<%= ENV['GF_SERVER_HTTP_PORT'] || '9002' %>;
}
