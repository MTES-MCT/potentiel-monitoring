# Route log ingestion to Vector, and all other traffic to Grafana.
# Backend URLs should point to process types (`vector` and `grafana`) on Scalingo.

location /vector {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Authorization $http_authorization;
  proxy_pass <%= ENV['VECTOR_BACKEND_URL'] %>;
}

location / {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass <%= ENV['GRAFANA_BACKEND_URL'] %>;
}
