# Route log ingestion to Vector, and all other traffic to Grafana.

location /vector {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Authorization $http_authorization;
  proxy_pass vector.<%= ENV['SCALINGO_APPLICATION_ID'] %>.<%= ENV['SCALINGO_PRIVATE_NETWORK_ID'] %>.private-network.internal::<%= ENV['VECTOR_INTERNAL_PORT'] || '9001' %>;
}

location / {
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id $request_id;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_pass grafana.<%= ENV['SCALINGO_APPLICATION_ID'] %>.<%= ENV['SCALINGO_PRIVATE_NETWORK_ID'] %>.private-network.internal::<%= ENV['GRAFANA_INTERNAL_PORT'] || '9002' %>;
}
