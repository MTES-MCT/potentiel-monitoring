inserted_at =  .timestamp
.message = strip_ansi_escape_codes!(.message)
., err = parse_regex(.message,r'(?<requested_at>^\d{4}-\d{2}-\d{2} \d\d:\d\d:\d\d\.\d{9} .\d{4} CET) \[(?<container>[\w\d\-]*)\]\W+(?<message>.*)')
.inserted_at = inserted_at

if err != null {
    log("Parse error: " + string!(err)+" Message: "+ string!(.message), level: "error",)
}

# Parse log with level and message
. |= parse_regex!(.message,r'(?<level>debug|info|error|warn)?:?\W*(?<message>.*)')

# Parse parts split by " | "
message_parts = split(.message, " | ")
.message = message_parts[0]
.requested_at =  parse_timestamp!(.requested_at,"%Y-%m-%d %H:%M:%S%.9f %z CET")
if message_parts[1] != null {
    .service = parse_regex(message_parts[1], r'Service\((?<service>[\w\d\-]*)\)').service ?? null
}

if message_parts[2] != null {
    .meta = parse_json(parse_regex(message_parts[2], r'Metadata\((?<meta>.*)\)').meta ?? {}) ?? null
} 


if .level == null {
    # Parse HTTP request logs
    http,err = parse_regex(.message, r'(?<method>GET|POST|PUT|DELETE|PATCH|OPTIONS|HEAD) (?<endpoint>/[^\s]*)\W*(?<status>\d{3})?.*(?<durationMS>\d+\.\d+)? ms')

    if err == null {
        .level = "http"
        .meta = http
    }
}