                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT count(*) AS total FROM logs WHERE $__timeFilter(ts) AND ('${level:csv}' = '' OR level IN ($level)) AND ('${service:csv}' = '' OR service IN ($service))",
