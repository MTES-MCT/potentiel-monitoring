            "title": "Log volume over time",
            "type": "timeseries",
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "potentiel-db"
                    },
                    "format": "time_series",
                    "rawQuery": true,
                    "rawSql": "SELECT $__timeGroupAlias(ts,$__interval), count(*) FILTER (WHERE level = 'error') AS \"error\", count(*) FILTER (WHERE level = 'warn') AS \"warn\", count(*) FILTER (WHERE level = 'info') AS \"info\", count(*) FILTER (WHERE level = 'http') AS \"http\", count(*) FILTER (WHERE level = 'debug') AS \"debug\" FROM logs WHERE $__timeFilter(ts) AND ('${service:csv}' = '' OR service IN ($service)) GROUP BY 1 ORDER BY 1",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 5,
            "type": "logs",
            "title": "Logs",
            "gridPos": {
                "h": 16,
                "w": 24,
                "x": 0,
                "y": 12
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "pluginVersion": "12.4.3+security-02",
            "targets": [
                {
                    "refId": "A",
                    "format": "table",
                    "rawSql": "SELECT ts, message, meta, level, service FROM logs WHERE $__timeFilter(ts) AND ('${level:csv}' = '' OR level IN ($level)) AND ('${service:csv}' = '' OR service IN ($service)) LIMIT 50 ",
                    "table": "logs",
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "potentiel-db"
                    }
                }
            ],
            "transformations": [
                {
                    "id": "extractFields",
                    "options": {
                        "delimiter": ",",
                        "format": "json",
                        "jsonPaths": [
                            {
                                "path": "correlationId"
                            },
                            {
                                "path": "messageType"
                            }
                        ],
                        "keepTime": false,
                        "replace": false,
                        "source": "meta"
                    }
                }
            ],
            "datasource": {
                "uid": "potentiel-db",
                "type": "grafana-postgresql-datasource"
            },
            "options": {
                "showTime": true,
                "wrapLogMessage": true,
                "unwrappedColumns": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "showControls": false,
                "dedupStrategy": "none",
                "sortOrder": "Descending",
                "showLabels": false,
                "timestampResolution": "ms",
                "prettifyLogMessage": true,
                "syntaxHighlighting": true,
                "detailsMode": "sidebar",
                "fontSize": "small"
            }
        }
