    "description": "Reusable logs panel only",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "logs",
            "title": "Logs",
            "gridPos": {
                "h": 24,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "fieldConfig": {
                "defaults": {},
                "overrides": []
            },
            "pluginVersion": "12.4.3+security-02",
            "targets": [
                {
                    "refId": "A",
                    "format": "table",
                    "rawSql": "SELECT ts, message, meta, level, service FROM logs WHERE $__timeFilter(ts) AND ('${level:csv}' = '' OR level IN ($level)) AND ('${service:csv}' = '' OR service IN ($service)) LIMIT 50 ",
                    "table": "logs",
                    "datasource": {
                        "type": "grafana-postgresql-datasource",
                        "uid": "potentiel-db"
                    }
                }
            ],
            "transformations": [
                {
                    "id": "extractFields",
                    "options": {
                        "delimiter": ",",
                        "format": "json",
                        "jsonPaths": [
                            {
                                "path": "correlationId"
                            },
                            {
                                "path": "messageType"
                            }
                        ],
                        "keepTime": false,
                        "replace": false,
                        "source": "meta"
                    }
                }
            ],
            "datasource": {
                "uid": "potentiel-db",
                "type": "grafana-postgresql-datasource"
            },
            "options": {
                "showTime": true,
                "wrapLogMessage": true,
                "unwrappedColumns": false,
                "enableLogDetails": true,
                "enableInfiniteScrolling": true,
                "showControls": false,
                "dedupStrategy": "none",
                "sortOrder": "Descending",
                "showLabels": false,
                "timestampResolution": "ms",
                "prettifyLogMessage": true,
                "syntaxHighlighting": true,
                "detailsMode": "sidebar",
                "fontSize": "small"
            }
        }
    ],
    "refresh": "30s",
    "schemaVersion": 38,
    "tags": [
        "logs",
        "potentiel"
    ],
